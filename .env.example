# =============================================================================
# VC-INGRESO – Variables de entorno (backend PHP / Docker)
# Copiar a .env y ajustar. En Docker el servicio "api" recibe DB_HOST=mysql.
# URL de la API para el frontend: environment.ts, environment.stage.ts, environment.prod.ts
# =============================================================================

APP_ENV=local
APP_DEBUG=true

# --- Base de datos ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=Oscorpsvr
DB_CHARSET=utf8mb4
DB_NAME=vc_db
DB_LICENSE_NAME=crearttech_clientes

# --- CORS (cambiar por entorno) ---
# Dev:    CORS_ALLOW_ORIGIN=*
# Stage:  CORS_ALLOW_ORIGIN=http://13.218.39.221:8086
# Prod:   CORS_ALLOW_ORIGIN=https://villa-club5.com
CORS_ALLOW_ORIGIN=*

# --- Ejemplo mínimo para STAGE (copiar y ajustar en .env del servidor) ---
# APP_ENV=stage
# APP_DEBUG=false
# DB_NAME=vc_db
# DB_LICENSE_NAME=crearttech_clientes
# DB_USER=root
# DB_PASS=<tu_password_segura>
# DB_CHARSET=utf8mb4
# CORS_ALLOW_ORIGIN=http://13.218.39.221:8086
#
# --- Ejemplo mínimo para PROD con dominio villa-club5.com ---
# APP_ENV=prod
# APP_DEBUG=false
# DB_NAME=vc_db
# DB_LICENSE_NAME=crearttech_clientes
# DB_USER=root
# DB_PASS=<tu_password_segura>
# DB_CHARSET=utf8mb4
# CORS_ALLOW_ORIGIN=https://villa-club5.com

# --- Security ---
JWT_SECRET=change_me_to_a_secure_random_string
CSRF_SECRET=change_me_to_a_secure_random_string
# Duración del JWT de login (segundos). Por defecto 2592000 (30 días). Mínimo 3600 (1 h).
# JWT_AUTH_TTL_SECONDS=2592000

# --- APIs externas ---
RENIEC_API_TOKEN=api_token_reniec

# --- Almacenamiento S3 (media + backups de BD) ---
# El media vive solo en S3 (sin volumen local). Setup: docs/aws-s3-setup.md
# STORAGE_DRIVER queda obsoleto (siempre S3); se ignora si está presente.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=crearttech-storage
S3_KEY_PREFIX=vc-ingreso
# URL pública del prefijo media (sin slash final).
S3_MEDIA_PUBLIC_BASE_URL=https://crearttech-storage.s3.us-east-1.amazonaws.com/vc-ingreso/media
# Futuro: STORAGE_MEDIA_VISIBILITY=private (URLs firmadas / proxy auth)
# STORAGE_MEDIA_VISIBILITY=public
